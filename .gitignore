# ==============================================================================
# .gitignore for FastSpeech 2 Bilingual TTS (Indian English & Telugu)
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
venv_fs2/
.env/

# Temporary files & logs
*.tmp
*.log
.DS_Store
Thumbs.db
*.cache
*.cache/
audit_summary.json
phase3_phase4_audit.json

# Scratch and backups
scratch/
backup_previous_run/

# IDE & Editor files
.vscode/
.idea/

# Large raw and preprocessed datasets (~3.8 GB)
data/

# Intermediate training checkpoints (~418 MB each)
English/checkpoints/checkpoint_*.pth.tar
English/checkpoints/latest_model.pth.tar
Telugu/checkpoints/checkpoint_*.pth.tar
Telugu/checkpoints/latest_model.pth.tar

# Local utilities and reference implementations excluded from public submission
reference_fastspeech2/
scripts/
build_technical_report.py
plot_variance_adaptor.py
FastSpeech2_Assignment.pdf
English/speakers.json
Telugu/speakers.json
Results/English/loss_history.json
Results/English/test_predictions.json
Results/Telugu/loss_history.json
Results/Telugu/test_predictions.json
Report/english_audio_diagnosis.md
Report/english_multispeaker_training_report.md
